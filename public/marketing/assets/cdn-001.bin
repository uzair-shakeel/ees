doit avoir une raison.","/universites"],["Construire votre strat\xe9gie","Organiser une s\xe9lection \xe9quilibr\xe9e de candidatures ambitieuses, r\xe9alistes et plus prudentes.","/strategie"],["Pr\xe9parer votre dossier","Structurer votre CV, vos motivations, votre projet d'\xe9tudes et les pi\xe8ces n\xe9cessaires \xe0 vos candidatures.","/dossier"],["Pr\xe9parer votre arriv\xe9e","Logement, d\xe9marches et budget : l'accompagnement continue apr\xe8s l'admission.","/installation"]],bi=[["Programme","Que vais-je r\xe9ellement \xe9tudier ?"],["Ad\xe9quation","Mon profil correspond-il aux pr\xe9requis ?"],["S\xe9lectivit\xe9","Quel niveau de candidature est r\xe9aliste ?"],["Budget","Frais de scolarit\xe9 et co\xfbt de la ville."],["Localisation","Quel environnement \xe9tudiant me correspond ?"],["D\xe9bouch\xe9s","Que permet r\xe9ellement cette formation ?"]],yi=[["Ambitieuse","Des formations plus s\xe9lectives qui correspondent \xe0 votre projet et m\xe9ritent d'\xeatre tent\xe9es."],["R\xe9aliste","Des candidatures coh\xe9rentes avec votre dossier acad\xe9mique et votre profil."],["Prudente","Des options suppl\xe9mentaires pour r\xe9duire le risque d'une strat\xe9gie trop concentr\xe9e."]],xi=["Comprendre votre calendrier","Pr\xe9parer vos documents","Organiser vos candidatures","Constituer votre dossier","V\xe9rifier chaque \xe9tape","Suivre les r\xe9ponses","Pr\xe9parer la suite apr\xe8s admission"],wi={orientation:{label:"Orientation",title:"Trouver une direction avant de chercher une universit\xe9.",intro:"Le premier choix n'est pas celui de l'\xe9tablissement. C'est celui de la direction que vous voulez donner \xe0 vos \xe9tudes.",photo:"library",alt:"\xc9tudiante explorant les rayons d'une biblioth\xe8que",cta:"Commencer mon orientation",section:"Votre profil dans son ensemble.",items:[["Parcours acad\xe9mique","Dipl\xf4mes, r\xe9sultats, mati\xe8res \xe9tudi\xe9es et progression."],["Centres d'int\xe9r\xeat","Ce que vous aimez r\xe9ellement apprendre et approfondir."],["Forces","Mati\xe8res, comp\xe9tences et environnements dans lesquels vous \xeates le plus \xe0 l'aise."],["Projet professionnel","Secteurs, m\xe9tiers ou trajectoires que vous souhaitez explorer."],["Pr\xe9f\xe9rences","Ville, environnement universitaire, langue et style d'\xe9tudes."],["Contraintes","Budget, calendrier, niveau d'\xe9tudes et conditions particuli\xe8res."]],statement:"Du profil \xe0 une direction claire.",body:"Votre conseiller confronte vos objectifs \xe0 la r\xe9alit\xe9 des formations disponibles afin de faire \xe9merger plusieurs pistes coh\xe9rentes. L'objectif n'est pas de d\xe9cider \xe0 votre place, mais de vous donner suffisamment de contexte pour prendre une d\xe9cision \xe9clair\xe9e.",outputTitle:"\xc0 la fin, vous savez quoi chercher.",outputs:["Domaines recommand\xe9s","Types de dipl\xf4mes","Crit\xe8res prioritaires","Premi\xe8res formations \xe0 explorer","Prochaines \xe9tapes","Feuille de route personnalis\xe9e"],next:["Comprendre les formations","/formations"]},formations:{label:"Formations",title:"Choisir une formation qui a du sens pour votre projet.",intro:"Un intitul\xe9 ne suffit pas. Nous regardons ce que vous allez r\xe9ellement apprendre, les pr\xe9requis, le niveau attendu et ce que la formation peut vous permettre ensuite.",photo:"advisor",alt:"\xc9tudiant dans une biblioth\xe8que universitaire",cta:"Parler de ma formation",section:"Comprendre les diff\xe9rents parcours.",items:[["Licence","Un parcours universitaire progressif permettant de construire des bases acad\xe9miques solides."],["Bachelor","Des formations souvent plus sp\xe9cialis\xe9es et professionnalisantes selon l'\xe9tablissement. Le statut du dipl\xf4me et sa reconnaissance doivent \xeatre v\xe9rifi\xe9s."],["Master","Une sp\xe9cialisation avanc\xe9e apr\xe8s un premier cycle d'\xe9tudes sup\xe9rieures, selon les conditions d'acc\xe8s du programme."],["\xc9coles de commerce","Des cursus orient\xe9s management, finance, marketing, strat\xe9gie, entrepreneuriat et autres disciplines de gestion."],["\xc9coles d'ing\xe9nieurs","Des parcours scientifiques et techniques pouvant conduire \xe0 diff\xe9rentes sp\xe9cialisations. Les conditions d'admission varient selon les \xe9coles."]],statement:"Regarder au-del\xe0 de l'intitul\xe9.",body:"Le contenu, la reconnaissance du dipl\xf4me et les pr\xe9requis m\xe9ritent autant d'attention que le nom de l'\xe9tablissement. Les structures et parcours varient : nous v\xe9rifions les informations publi\xe9es pour chaque formation.",outputTitle:"Ce que nous regardons avant de recommander.",outputs:["Contenu p\xe9dagogique","Pr\xe9requis et niveau acad\xe9mique","Langue d'enseignement","Sp\xe9cialisation","Stages et exp\xe9rience professionnelle","D\xe9bouch\xe9s","\xc9tablissement","Budget et localisation"],next:["Explorer les formations","/universites#catalogue"]},strategie:{label:"Strat\xe9gie de candidature",title:"Une candidature doit faire partie d'une strat\xe9gie.",intro:"Les choix d'\xe9tablissement, les calendriers, le niveau de s\xe9lectivit\xe9 et la qualit\xe9 du dossier doivent fonctionner ensemble.",photo:"student",alt:"Documents et ordinateur pour pr\xe9parer un projet d'\xe9tudes",cta:"Construire ma strat\xe9gie",section:"Chaque candidature doit avoir une raison.",items:[["Identifier les priorit\xe9s","Quelles formations correspondent le mieux \xe0 votre projet ?"],["\xc9valuer la coh\xe9rence","O\xf9 votre profil semble-t-il r\xe9pondre aux crit\xe8res demand\xe9s ?"],["\xc9quilibrer la s\xe9lection","R\xe9partir les candidatures entre diff\xe9rents niveaux de s\xe9lectivit\xe9."],["Organiser les \xe9ch\xe9ances","Anticiper les documents et dates importantes."],["Adapter le dossier","Chaque candidature doit \xeatre comprise dans son contexte."],["Suivre l'avancement","Centraliser les \xe9tapes dans votre espace \xe9tudiant existant."]],statement:"Une s\xe9lection coh\xe9rente. Pas une course au nombre.",body:"Nous construisons avec vous un \xe9quilibre entre candidatures ambitieuses, r\xe9alistes et prudentes. Une candidature prudente ne signifie jamais qu'une admission est garantie : la d\xe9cision appartient \xe0 chaque \xe9tablissement.",next:["Comprendre l'accompagnement dossier","/dossier"]},dossier:{label:"Accompagnement dossier",title:"Un bon dossier raconte un projet coh\xe9rent.",intro:"Les documents ne doivent pas simplement exister. Ils doivent permettre \xe0 l'\xe9tablissement de comprendre votre parcours, votre choix et votre objectif.",photo:"student",alt:"Notes, documents et ordinateur sur un espace de travail \xe9tudiant",cta:"Pr\xe9parer mon dossier",section:"Des documents qui se r\xe9pondent.",items:[["CV","Pr\xe9senter clairement votre parcours acad\xe9mique, vos exp\xe9riences et vos comp\xe9tences."],["Lettre de motivation","Expliquer pourquoi cette formation correspond \xe0 votre projet."],["Projet d'\xe9tudes","Relier votre pass\xe9 acad\xe9mique, votre choix actuel et votre objectif futur."],["Pi\xe8ces acad\xe9miques","Relev\xe9s, dipl\xf4mes, attestations et autres justificatifs n\xe9cessaires."],["Documents compl\xe9mentaires","Certifications linguistiques, traductions ou autres \xe9l\xe9ments demand\xe9s selon la candidature."]],statement:"Vous restez l'auteur de votre dossier.",body:"Notre r\xf4le est de vous guider, de vous aider \xe0 structurer vos id\xe9es, d'identifier les incoh\xe9rences et de rendre votre pr\xe9sentation plus claire. Nous ne rempla\xe7ons jamais votre histoire par un texte g\xe9n\xe9rique.",next:["Comprendre la proc\xe9dure \xc9tudes en France","/procedure-eef"]},"procedure-eef":{label:"Proc\xe9dure EEF",title:"\xc9tudes en France, \xe9tape par \xe9tape.",intro:"Une vue claire de la proc\xe9dure afin de savoir quoi pr\xe9parer, quand agir et quelle \xe9tape vient ensuite.",photo:"campus",alt:"Architecture universitaire et vie \xe9tudiante \xe0 Paris",cta:"Parler de ma proc\xe9dure",section:"Une feuille de route, pas du jargon.",items:[["Comprendre votre situation","Pays de r\xe9sidence, niveau d'\xe9tudes, formation recherch\xe9e et calendrier."],["Pr\xe9parer vos documents","Rassembler les pi\xe8ces acad\xe9miques et administratives demand\xe9es."],["Construire vos choix","S\xe9lectionner les formations coh\xe9rentes avec votre projet."],["Pr\xe9parer votre dossier","Structurer les \xe9l\xe9ments acad\xe9miques et les motivations."],["Effectuer les \xe9tapes applicables","Suivre les d\xe9marches correspondant \xe0 votre situation."],["Suivre les r\xe9ponses","Rester organis\xe9 pendant la p\xe9riode d'admission."],["Pr\xe9parer la suite","Une fois admis, avancer vers les d\xe9marches n\xe9cessaires \xe0 votre arriv\xe9e en France."]],statement:"Votre situation d\xe9termine votre parcours.",body:"La proc\xe9dure applicable d\xe9pend notamment de votre pays de r\xe9sidence, du niveau vis\xe9 et de l'\xe9tablissement. Les r\xe8gles et les calendriers \xe9voluent : v\xe9rifiez toujours les exigences aupr\xe8s des sources officielles.",next:["Identifier ma voie de candidature","/admissions"],trust:!0}},ji=[{slug:"choisir-sa-formation",categorie:"Orientation",titre:"Comment choisir sa formation quand plusieurs domaines vous int\xe9ressent ?",extrait:"Avant de choisir un \xe9tablissement, prenez le temps de comprendre ce qui vous donne envie d'apprendre.",photo:"library",service:"/orientation",contenu:[["Partir de ce que vous aimez apprendre","Distinguez les mati\xe8res que vous appr\xe9ciez des m\xe9tiers que vous imaginez. Notez les projets, les cours et les exp\xe9riences qui vous ont r\xe9ellement int\xe9ress\xe9, puis cherchez ce qu'ils ont en commun."],["Comparer les contenus, pas seulement les noms","Deux formations aux intitul\xe9s proches peuvent avoir des approches tr\xe8s diff\xe9rentes. Consultez les unit\xe9s d'enseignement, les modalit\xe9s d'\xe9valuation et les pr\xe9requis publi\xe9s par chaque \xe9tablissement."],["Licence, Bachelor ou Master : pr\xe9ciser le niveau","Le choix d\xe9pend d'abord de votre parcours actuel. La Licence construit des bases universitaires ; les Bachelors varient selon leur \xe9tablissement et leur reconnaissance ; le Master approfondit une sp\xe9cialisation apr\xe8s un premier cycle. V\xe9rifiez toujours les conditions d'acc\xe8s et le statut du dipl\xf4me."],["Garder plusieurs pistes, puis les confronter","Mettez vos options en regard de votre budget, de votre niveau et de votre projet professionnel. Un \xe9change avec un conseiller aide \xe0 hi\xe9rarchiser vos crit\xe8res sans d\xe9cider \xe0 votre place."]]},{slug:"universite-publique-ecole-privee",categorie:"Formations",titre:"Universit\xe9 publique ou \xe9cole priv\xe9e : quelles diff\xe9rences regarder ?",extrait:"Reconnaissance, contenu, budget : les crit\xe8res qui comptent vraiment pour votre choix.",photo:"campus",service:"/formations",contenu:[["V\xe9rifier le dipl\xf4me exact","Le statut public ou priv\xe9 ne suffit pas \xe0 comprendre une formation. Identifiez le dipl\xf4me d\xe9livr\xe9, sa reconnaissance et les conditions de poursuite d'\xe9tudes. Appuyez-vous sur les informations officielles, pas uniquement sur la brochure."],["Observer la mani\xe8re d'apprendre","Comparez le programme d\xe9taill\xe9, la place des projets, les stages, les conditions d'encadrement et la langue d'enseignement. Chaque parcours a sa propre organisation."],["Calculer le budget global","Au-del\xe0 de la scolarit\xe9, int\xe9grez le logement, les transports et les d\xe9penses de d\xe9part. Les frais varient selon le programme et votre situation : v\xe9rifiez leur montant et les conditions de paiement directement aupr\xe8s de l'\xe9tablissement."]]},{slug:"construire-une-shortlist",categorie:"Universit\xe9s",titre:"Construire une shortlist d'universit\xe9s : la m\xe9thode",extrait:"Une s\xe9lection r\xe9fl\xe9chie vaut mieux qu'une longue liste. Chaque candidature doit avoir une raison.",photo:"campus",service:"/universites",contenu:[["D\xe9finir vos crit\xe8res avant vos noms","Commencez par votre domaine, votre niveau, votre budget et votre langue d'\xe9tudes. Ajoutez vos pr\xe9f\xe9rences de ville et le contenu p\xe9dagogique recherch\xe9. Ces crit\xe8res donnent une base commune \xe0 votre comparaison."],["Documenter chaque option","Pour chaque formation retenue, notez les pr\xe9requis, le programme, la voie de candidature et le calendrier officiel. Gardez le lien de la source et la date de consultation."],["\xc9quilibrer votre s\xe9lection","Construisez une s\xe9lection de candidatures ambitieuses, r\xe9alistes et plus prudentes. Cette r\xe9partition ne garantit aucune admission : elle \xe9vite de concentrer tout votre projet sur une seule hypoth\xe8se."]]},{slug:"projet-etudes-coherent",categorie:"Dossier",titre:"Comment structurer un projet d'\xe9tudes coh\xe9rent ?",extrait:"Votre dossier doit relier ce que vous avez appris, ce que vous choisissez et ce que vous souhaitez construire.",photo:"student",service:"/dossier",contenu:[["Partir de votre parcours r\xe9el","Pr\xe9sentez les \xe9tapes acad\xe9miques et les exp\xe9riences qui expliquent votre choix. Une r\xe9orientation peut \xeatre coh\xe9rente si vous en exposez les raisons et les comp\xe9tences d\xe9j\xe0 acquises."],["Expliquer la formation choisie","Citez les enseignements ou les approches p\xe9dagogiques qui r\xe9pondent \xe0 votre objectif. \xc9vitez les compliments g\xe9n\xe9riques : montrez ce que vous avez compris de la formation."],["Relier les \xe9tudes \xe0 la suite","D\xe9crivez une direction professionnelle cr\xe9dible, m\xeame si votre m\xe9tier exact reste \xe0 pr\xe9ciser. Votre projet n'a pas besoin d'\xeatre fig\xe9, mais ses liens doivent \xeatre compr\xe9hensibles."],["Rester l'auteur de votre texte","Une relecture peut rendre vos id\xe9es plus claires et rep\xe9rer les incoh\xe9rences. Les motivations, les exp\xe9riences et la formulation doivent rester fid\xe8les \xe0 votre histoire."]]},{slug:"erreurs-candidature",categorie:"Dossier",titre:"Les erreurs qui rendent une candidature difficile \xe0 comprendre",extrait:"Mieux pr\xe9senter son parcours commence souvent par enlever ce qui brouille le message.",photo:"conversation",service:"/strategie",contenu:[["Utiliser la m\xeame motivation partout","Une lettre sans lien pr\xe9cis avec le programme ne permet pas de comprendre votre choix. Adaptez votre argumentation au contenu de la formation et aux attentes publi\xe9es."],["Laisser des contradictions","Relisez ensemble le CV, le projet d'\xe9tudes et la lettre. Les dates, les intitul\xe9s et les objectifs doivent \xeatre coh\xe9rents. Expliquez simplement une interruption ou un changement de direction."],["Oublier les consignes","V\xe9rifiez les formats, les pi\xe8ces demand\xe9es et les \xe9ch\xe9ances sur le portail officiel. Une candidature claire respecte d'abord les indications propres \xe0 l'\xe9tablissement."]]},{slug:"preparer-son-depart",categorie:"Vie en France",titre:"Pr\xe9parer son d\xe9part en France : la checklist",extrait:"De l'admission aux premi\xe8res semaines : organiser la vie r\xe9elle avant le d\xe9part.",photo:"city",service:"/installation",contenu:[["Confirmer les \xe9tapes applicables","Apr\xe8s l'admission, v\xe9rifiez les formalit\xe9s li\xe9es \xe0 votre nationalit\xe9, votre r\xe9sidence et la dur\xe9e du s\xe9jour. Pour le visa lorsqu'il est n\xe9cessaire, consultez France-Visas et les consignes de l'autorit\xe9 comp\xe9tente."],["Pr\xe9parer son budget \xe9tudiant","S\xe9parez les d\xe9penses initiales du budget mensuel. Anticipez le logement, l'alimentation, les transports, l'assurance, la scolarit\xe9 et une marge pour les impr\xe9vus. V\xe9rifiez les co\xfbts dans votre ville plut\xf4t que de vous fier \xe0 une moyenne nationale."],["Organiser son arriv\xe9e","Pr\xe9parez votre premi\xe8re solution d'h\xe9bergement, votre trajet et une copie de vos documents importants. Rep\xe9rez ensuite les d\xe9marches de sant\xe9, de transport et d'inscription applicables \xe0 votre situation."]]},{slug:"documents-logement",categorie:"Logement",titre:"Trouver un logement \xe9tudiant : quels documents pr\xe9parer ?",extrait:"Un dossier locatif organis\xe9 pour aborder votre recherche plus sereinement.",photo:"city",service:"/appartements",contenu:[["Identifier les justificatifs demand\xe9s","Selon le bailleur et votre situation, des justificatifs d'identit\xe9, de scolarit\xe9, de ressources ou de garantie peuvent \xeatre demand\xe9s. V\xe9rifiez la liste applicable et les documents qu'un propri\xe9taire est l\xe9galement autoris\xe9 \xe0 exiger."],["Prot\xe9ger ses informations","N'envoyez pas votre dossier complet \xe0 un contact non v\xe9rifi\xe9. Vous pouvez consulter le service public DossierFacile pour pr\xe9parer des documents prot\xe9g\xe9s et suivre ses recommandations."],["Ne pas confondre dossier et garantie de logement","Un dossier pr\xe9par\xe9 facilite la recherche, mais ne garantit pas l'attribution d'un logement. V\xe9rifiez l'annonce, le bailleur et les conditions du bail avant tout engagement ou paiement."]]},{slug:"comprendre-etudes-en-france",categorie:"\xc9tudes en France",titre:"Comprendre la proc\xe9dure \xc9tudes en France",extrait:"Les bons rep\xe8res pour savoir quoi pr\xe9parer, quand agir et aupr\xe8s de qui v\xe9rifier.",photo:"advisor",service:"/procedure-eef",contenu:[["Comprendre si la proc\xe9dure vous concerne","La proc\xe9dure applicable d\xe9pend de votre pays de r\xe9sidence, du niveau recherch\xe9 et de l'\xe9tablissement. Consultez votre espace Campus France local et les indications officielles de la formation vis\xe9e."],["Travailler \xe0 partir du calendrier officiel","Identifiez les \xe9tapes et dates qui correspondent \xe0 votre candidature. Les calendriers changent selon le pays, la campagne et le type de formation : ne reprenez pas une date sans v\xe9rifier sa source."],["Conserver une vue d'ensemble","Rassemblez les pi\xe8ces, pr\xe9parez vos choix et suivez les demandes compl\xe9mentaires sur les plateformes concern\xe9es. Un conseiller peut vous aider \xe0 organiser ces \xe9tapes, sans se substituer aux organismes officiels."]]}],ki=["Orientation","Formations","Universit\xe9s","Dossier","\xc9tudes en France","Logement","Vie en France"],Ni=e=>({Orientation:"library",Formations:"advisor","Universit\xe9s":"campus",Dossier:"student",Logement:"city","Vie en France":"city",Visa:"city"}[e]||"campus"),Si=()=>(0,De.jsxs)("section",{className:"ed-section ed-wrap ed-journey",id:"parcours","data-testid":"home-journey",children:[(0,De.jsxs)("div",{className:"ed-journey-intro",children:[(0,De.jsx)(ci,{children:"01 \u2014 DE A \xc0 Z"}),(0,De.jsxs)("h2",{children:["Votre parcours,",(0,De.jsx)("br",{}),"\xe9tape par \xe9tape."]}),(0,De.jsx)("p",{children:"Chaque \xe9tape influence la suivante. Nous construisons donc votre projet dans le bon ordre plut\xf4t que de commencer directement par les candidatures."}),(0,De.jsx)("span",{className:"ed-large-index","aria-hidden":"true",children:"01\u201406"})]}),(0,De.jsx)(mi,{items:gi,id:"journey"})]}),Ei=()=>(0,De.jsx)("section",{className:"ed-section ed-orientation","data-testid":"home-orientation",children:(0,De.jsxs)("div",{className:"ed-wrap",children:[(0,De.jsx)(ci,{children:"02 \u2014 TOUT COMMENCE PAR VOUS"}),(0,De.jsxs)("h2",{children:["Vous ne savez pas encore",(0,De.jsx)("br",{}),"exactement quoi \xe9tudier\xa0?",(0,De.jsx)("br",{}),(0,De.jsx)("span",{children:"C'est l\xe0 que tout commence."})]}),(0,De.jsxs)("div",{className:"ed-orientation-grid",children:[(0,De.jsx)(li,{name:"library",alt:"\xc9tudiante choisissant un ouvrage \xe0 la biblioth\xe8que"}),(0,De.jsxs)("div",{children:[(0,De.jsx)("p",{className:"ed-intro",children:"Avant de parler d'universit\xe9s, nous prenons le temps de comprendre votre profil."}),(0,De.jsx)("div",{className:"ed-profile-list",children:[["Votre parcours","Ce que vous avez d\xe9j\xe0 \xe9tudi\xe9."],["Vos forces","Les mati\xe8res et comp\xe9tences qui vous correspondent."],["Vos ambitions","Ce que vous aimeriez construire professio