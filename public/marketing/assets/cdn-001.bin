ement, notamment pour le logement et les d\xe9marches pratiques. Aucun logement ni visa n'est garanti."],["\xc0 quoi sert l'espace \xe9tudiant ?","Il permet de centraliser votre progression, vos documents et les diff\xe9rentes \xe9tapes de votre projet. L'espace actuel est une d\xe9monstration ; il ne remplace pas les plateformes officielles de candidature."]];function Rh(){return(0,De.jsxs)("main",{"data-testid":"faq-page",children:[(0,De.jsx)(pi,{title:"Questions fr\xe9quentes",description:"Orientation, candidatures, proc\xe9dure EEF et installation : des r\xe9ponses claires \xe0 vos questions sur notre accompagnement humain."}),(0,De.jsxs)("div",{className:"ed-wrap ed-faq",children:[(0,De.jsxs)("header",{className:"ed-faq-title",children:[(0,De.jsxs)("div",{children:[(0,De.jsx)(ci,{children:"LES R\xc9PONSES, SIMPLEMENT."}),(0,De.jsxs)("h1",{children:["Vos questions.",(0,De.jsx)("br",{}),"Nos r\xe9ponses."]})]}),(0,De.jsxs)("div",{children:[(0,De.jsx)("p",{children:"Comprendre l'accompagnement avant de commencer. Et pouvoir en parler, tout simplement."}),(0,De.jsx)(ui,{to:"/contact",id:"faq-contact-cta",children:"Poser ma question"})]})]}),(0,De.jsxs)("section",{className:"ed-faq-body",children:[(0,De.jsx)(ci,{children:"L'ACCOMPAGNEMENT EEF"}),(0,De.jsx)(Nh,{type:"single",collapsible:!0,children:Ph.map((e,t)=>{let n=l(e,2),r=n[0],a=n[1];return(0,De.jsxs)(Sh,{value:"question-".concat(t),children:[(0,De.jsx)(Eh,{className:"ed-faq-question","data-testid":"faq-q-".concat(t),children:r}),(0,De.jsx)(Ch,{className:"ed-faq-answer","data-testid":"faq-a-".concat(t),children:a})]},r)})})]})]}),(0,De.jsx)(vi,{id:"faq",title:"Votre question m\xe9rite une vraie conversation."})]})}function Oh(e){let t=e.page;const n=wi[t];return(0,De.jsxs)("main",{className:"ed-information ed-information-".concat(t),"data-testid":"".concat(t,"-page"),children:[(0,De.jsx)(pi,{title:n.label,description:n.intro}),(0,De.jsx)(fi,{label:n.label,title:n.title,intro:n.intro,photo:n.photo,alt:n.alt,chil